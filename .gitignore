# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template itself, which has no real values and exists
# specifically to be committed and read by anyone setting up this project.
# A real, previously-unnoticed bug this fixes: `.env*` was silently
# swallowing .env.example too — `git ls-files .env.example` confirmed it
# had never actually been tracked despite existing in the working tree and
# every part of this codebase's own tooling/comments assuming it was a
# committed reference (see the file's own header comment: "Copy this file
# to .env.local").
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design references — not app source; may contain unlicensed/AI-generated
# material not meant for the shipped product (see docs/architecture)
/reference designs/

# mobile app + shared package — deliberately isolated on the
# feature/mobile-app branch, not main. Ignored here so it can't get swept
# back in by a future "commit everything" on this branch; already-tracked
# on feature/mobile-app, where .gitignore has no effect on tracked files.
/apps/
/packages/
