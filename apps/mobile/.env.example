# Same Supabase project as the web app's own .env.example — public/publishable
# values, safe to ship in the app bundle (protected by Row Level Security,
# not secrecy). Expo only exposes vars prefixed EXPO_PUBLIC_ to app code.
# Copy this file to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API), or copy the values straight out of the web
# app's own root .env.local — same project, same values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER add a service-role key, SUPABASE_SERVICE_ROLE_KEY, or any other
# private/secret credential to this file or any EXPO_PUBLIC_* variable --
# anything with that prefix ships inside the compiled app bundle and is
# readable by anyone who installs it. Service-role access stays server-only
# (see the web app's src/lib/supabase/service.ts) and mobile never needs it.
