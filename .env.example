# Supabase project connection — public/publishable values, safe to expose to
# the browser (protected by Row Level Security, not by secrecy). Copy this
# file to .env.local and fill in your project's actual values from the
# Supabase dashboard (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OPTIONAL override for the app's own canonical URL — see
# src/lib/site-url.ts. Only actually read server-side / in contexts with no
# `window` (e.g. the admin "Invite user" email's redirectTo); client-side
# code uses window.location.origin instead, so leaving this unset in local
# dev is fine. It is now also fine to leave unset in production: without
# it, the server-side fallback detects Vercel's own auto-injected
# VERCEL_ENV variable and uses the real production domain
# (https://www.manutdfanshub.com) automatically — no manual Vercel
# dashboard step required. Confirmed live: this project's actual Vercel
# environment never had this var set at all, which used to mean the
# fallback silently became http://localhost:3000 in production (a dead
# link for real recipients) — that's what the VERCEL_ENV-aware fallback
# now fixes. Only set this explicitly if you need to override that default
# (e.g. pinning a specific preview deployment's own URL) — no trailing
# slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API-Football (v3.football.api-sports.io) — server-side ONLY. Never prefix
# with NEXT_PUBLIC_ (that would ship it to every visitor's browser). Read by
# src/lib/matches/provider.ts, which refuses to import from client code at
# all (see its own runtime `typeof window` guard) — the browser never talks
# to API-Football directly, only via Supabase-cached data this app's own
# server writes (see src/lib/matches/sync.ts and the
# /api/manchester-united/* routes).
API_FOOTBALL_KEY=
# OPTIONAL dev/testing override ONLY — do not set this in a real production
# deployment. Without it, the app dynamically resolves whatever season is
# actually current (see src/lib/matches/season.ts + sync.ts's
# resolveCurrentSeason — August 2026 correctly resolves to 2026, no code
# change needed when a season rolls over). Set it only when you deliberately
# want to pin a specific season for local development or testing — e.g. this
# project's own local `.env.local` currently sets it to 2024 specifically
# because that's the only season the configured API-Football plan can
# actually reach right now (see the api-football-free-tier-season-cap note
# in the architecture docs / football_capabilities table), not because
# production is meant to be locked to it.
API_FOOTBALL_SEASON=

# Supabase service-role key — server-side ONLY, never NEXT_PUBLIC_. Bypasses
# Row Level Security entirely, so treat it like any other admin credential.
# Required for match_lineups/match_events/players/matches/sync_status writes
# (src/lib/matches/sync.ts) — every one of those tables intentionally has no
# client-writable RLS policy, so sync can only ever happen through this key,
# never through a visitor's own session. Get it from Supabase dashboard →
# Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Secret Vercel Cron sends as `Authorization: Bearer <value>` when it calls
# /api/cron/award-periods (see vercel.json's `crons` entry and that route's
# own comment) — server-side ONLY. Any random long string works; Vercel
# generates and sets this automatically for projects with Cron Jobs
# enabled, but it must also be set here for local testing (curl the route
# yourself with the same header) since `next dev` never fires cron itself.
CRON_SECRET=
